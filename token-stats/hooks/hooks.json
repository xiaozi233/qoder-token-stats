{
  "description": "Print token throughput statistics when a turn finishes",
  "hooks": {
    "Stop": [
      {
        "async": false,
        "hooks": [
          {
            "type": "command",
            "command": "cmd.exe",
            "args": [
              "/d",
              "/c",
              "${QODER_PLUGIN_ROOT}/bin/token-stats.cmd",
              "stop-stats"
            ],
            "name": "token-stats-stop",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
