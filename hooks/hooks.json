{
  "description": "token-stats: measure the turn at Stop, and instruct the model to quote it",
  "hooks": {
    "UserPromptSubmit": [
      {
        "async": false,
        "hooks": [
          {
            "type": "command",
            "command": "cmd.exe",
            "args": [
              "/d",
              "/c",
              "${QODER_PLUGIN_ROOT}/bin/token-stats.cmd",
              "prompt-submit"
            ],
            "name": "token-stats-prompt-submit",
            "timeout": 8
          }
        ]
      }
    ],
    "Stop": [
      {
        "async": false,
        "hooks": [
          {
            "type": "command",
            "command": "cmd.exe",
            "args": [
              "/d",
              "/c",
              "${QODER_PLUGIN_ROOT}/bin/token-stats.cmd",
              "stop-stats"
            ],
            "name": "token-stats-stop",
            "timeout": 8
          }
        ]
      }
    ]
  }
}
